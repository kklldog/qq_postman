# QQ 邮箱地址
QQ_EMAIL=your_qq_number@qq.com
# QQ 邮箱设置中生成的授权码，不是网页登录密码
SMTP_AUTHCODE=replace_with_qq_authorization_code

# HTTP 服务
HOST=0.0.0.0
PORT=3000
# 设置后，发送接口和订阅接口需要 x-api-key 或 Authorization: Bearer <key>
API_KEY=
# 页面配置接口专用密钥；未设置时沿用 API_KEY
ADMIN_API_KEY=

# QQ 邮箱服务器（通常无需修改）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true

# 收信监听
MAILBOX=INBOX
MAIL_POLL_INTERVAL_MS=30000
# 首次启动是否把现有邮件也推送出去；默认 false，只监听启动后的新邮件
MAIL_INITIAL_SYNC=false
# 保存已处理 UID，避免服务重启重复推送
STATE_FILE=data/mail-state.json
# 页面保存的账号配置文件，优先级高于 QQ_EMAIL/SMTP_AUTHCODE
ACCOUNT_CONFIG_FILE=data/mail-account.json
# 是否把附件内容作为 base64 放入推送 JSON
INCLUDE_ATTACHMENT_CONTENT=true
# 单个附件最大推送字节数，超过后只推送元数据
MAX_ATTACHMENT_BYTES=10485760

# 可选：收到邮件后同时 POST 到固定 Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=3
